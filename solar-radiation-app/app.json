{
  "expo": {
    "name": "Radiación Solar",
    "slug": "solar-radiation-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f172a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.solarradiation.app"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0f172a"
      },
      "edgeToEdgeEnabled": true,
      "package": "com.solarradiation.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "description": "Aplicación para visualizar estadísticas de radiación solar durante el día",
    "platforms": ["ios", "android", "web"]
  }
}
